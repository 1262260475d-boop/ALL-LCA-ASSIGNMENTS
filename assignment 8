Q8a) Write a C function to swap 2 numbers using pointers ( call by reference).
#include<stdio.h>
int changeRef(int*p){
*p = 100;
return *p;
}
int main(){
int b = 20;
changeRef(&b);
printf("After call by reference, b=%d\n",b);
return 0;
}

